# =============================================================================
# Mẫu cấu hình môi trường cho frontend (Next.js).
#
# Cách dùng:
#   cp .env.example .env.local     rồi sửa nếu cần
#
# Next.js đọc frontend/.env.local (đã nằm trong .gitignore), KHÔNG đọc file
# .env ở gốc repo. File .env gốc chỉ dùng cho docker-compose và backend.
#
# CẢNH BÁO: mọi biến NEXT_PUBLIC_* được nhúng thẳng vào bundle JavaScript gửi
# xuống trình duyệt — ai mở DevTools cũng đọc được. KHÔNG đặt khoá bí mật,
# mật khẩu hay chuỗi kết nối database ở đây.
# =============================================================================


# Địa chỉ gốc của API. Không có dấu / ở cuối.
#
# Có thể bỏ trống hoặc không tạo file .env.local: src/lib/apiClient.ts đã có sẵn
# giá trị mặc định http://localhost:5000, đúng với cách chạy backend ở RUNBOOK.
# Chỉ cần đặt biến này khi backend chạy ở cổng hoặc máy khác.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SIGNALR_HUB_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Chỉ bật trên máy phát triển/staging có dữ liệu seed demo; không bật ở production.
# Cần build lại frontend sau khi đổi vì biến NEXT_PUBLIC_* được nhúng vào bundle.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
