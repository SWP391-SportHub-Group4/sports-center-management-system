{
  "name": "sporthub-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests playwright.config.ts",
    "format:check": "prettier --check src tests playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "qrcode": "^1.5.4",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
