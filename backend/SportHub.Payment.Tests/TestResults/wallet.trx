      CREATE TABLE legacy_relationship_class_links AS&#xD;
    SELECT relationship_id, class_id AS legacy_class_id&#xD;
    FROM coach_member_relationships&#xD;
    WHERE class_id IS NOT NULL;&#xD;
ALTER TABLE coach_member_relationships DROP CONSTRAINT fk_coach_member_relationships_classes_class_id;&#xD;
UPDATE coach_member_relationships SET class_id = NULL WHERE class_id IS NOT NULL;&#xD;
DO $$&#xD;
DECLARE r record;&#xD;
BEGIN&#xD;
    -- Ch? m?c (k? c? PK/unique) c?a b?ng cu: d?i t�n tru?c d? b?ng m?i d�ng l?i t�n g?c.&#xD;
    FOR r IN&#xD;
        SELECT indexname FROM pg_indexes&#xD;
        WHERE schemaname = current_schema()&#xD;
          AND tablename IN ('classes', 'class_recurrences', 'class_sessions', 'enrollments', 'attendances')&#xD;
    LOOP&#xD;
        EXECUTE format('ALTER INDEX %I RENAME TO %I', r.indexname, 'legacy_' || r.indexname);&#xD;
    END LOOP;&#xD;
    -- Sequence c?a c?t identity thu?c b?ng cu.&#xD;
    FOR r IN&#xD;
        SELECT s.relname AS seq&#xD;
        FROM pg_class s&#xD;
        JOIN pg_depend d ON d.objid = s.oid AND d.deptype IN ('a', 'i')&#xD;
        JOIN pg_class t ON t.oid = d.refobjid&#xD;
        WHERE s.relkind = 'S'&#xD;
          AND t.relname IN ('classes', 'class_recurrences', 'class_sessions', 'enrollments', 'attendances')&#xD;
    LOOP&#xD;
        EXECUTE format('ALTER SEQUENCE %I RENAME TO %I', r.seq, 'legacy_' || r.seq);&#xD;
    END LOOP;&#xD;
END $$;&#xD;
ALTER TABLE attendances RENAME TO legacy_attendances;&#xD;
ALTER TABLE enrollments RENAME TO legacy_enrollments;&#xD;
ALTER TABLE class_sessions RENAME TO legacy_class_sessions;&#xD;
ALTER TABLE class_recurrences RENAME TO legacy_class_recurrences;&#xD;
ALTER TABLE classes RENAME TO legacy_classes;&#xD;
