      CREATE TABLE classes (&#xD;
    class_id integer GENERATED BY DEFAULT AS IDENTITY,&#xD;
    code text NOT NULL,&#xD;
    name text NOT NULL,&#xD;
    sport_id integer NOT NULL,&#xD;
    coach_id uuid,&#xD;
    default_room_id integer NOT NULL,&#xD;
    start_date date NOT NULL,&#xD;
    num_sessions integer NOT NULL,&#xD;
    capacity integer NOT NULL,&#xD;
    price numeric(18,0) NOT NULL,&#xD;
    cost_amount numeric(18,0) NOT NULL,&#xD;
    break_even_threshold integer,&#xD;
    threshold_status integer NOT NULL,&#xD;
    threshold_deadline_utc timestamp with time zone,&#xD;
    threshold_response_deadline_utc timestamp with time zone,&#xD;
    status integer NOT NULL,&#xD;
    confirmed_count integer NOT NULL,&#xD;
    reserved_count integer NOT NULL,&#xD;
    created_by_ai boolean NOT NULL,&#xD;
    version integer NOT NULL,&#xD;
    created_at timestamp with time zone NOT NULL,&#xD;
    published_at timestamp with time zone,&#xD;
    CONSTRAINT pk_classes PRIMARY KEY (class_id),&#xD;
    CONSTRAINT ck_classes_capacity CHECK (capacity &gt; 0),&#xD;
    CONSTRAINT ck_classes_cost CHECK (cost_amount &gt;= 0),&#xD;
    CONSTRAINT ck_classes_counts CHECK (confirmed_count &gt;= 0 AND confirmed_count &lt;= reserved_count AND reserved_count &lt;= capacity),&#xD;
    CONSTRAINT ck_classes_num_sessions CHECK (num_sessions &gt; 0),&#xD;
    CONSTRAINT ck_classes_price CHECK (price &gt; 0 AND price % 1000 = 0),&#xD;
    CONSTRAINT fk_classes_rooms_default_room_id FOREIGN KEY (default_room_id) REFERENCES rooms (room_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_classes_sports_sport_id FOREIGN KEY (sport_id) REFERENCES sports (sport_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_classes_user_accounts_coach_id FOREIGN KEY (coach_id) REFERENCES user_accounts (user_id) ON DELETE RESTRICT&#xD;
);&#xD;
CREATE TABLE class_schedule_rules (&#xD;
    rule_id integer GENERATED BY DEFAULT AS IDENTITY,&#xD;
    class_id integer NOT NULL,&#xD;
    day_of_week integer NOT NULL,&#xD;
    start_time_local time without time zone NOT NULL,&#xD;
    CONSTRAINT pk_class_schedule_rules PRIMARY KEY (rule_id),&#xD;
    CONSTRAINT ck_class_schedule_rules_day CHECK (day_of_week BETWEEN 0 AND 6),&#xD;
    CONSTRAINT fk_class_schedule_rules_classes_class_id FOREIGN KEY (class_id) REFERENCES classes (class_id) ON DELETE CASCADE&#xD;
);&#xD;
CREATE TABLE class_sessions (&#xD;
    session_id uuid NOT NULL,&#xD;
    class_id integer NOT NULL,&#xD;
    session_no integer NOT NULL,&#xD;
    room_id integer NOT NULL,&#xD;
    coach_id uuid NOT NULL,&#xD;
    start_at_utc timestamp with time zone NOT NULL,&#xD;
    end_at_utc timestamp with time zone NOT NULL,&#xD;
    status integer NOT NULL,&#xD;
    rescheduled_from_session_id uuid,&#xD;
    is_makeup boolean NOT NULL,&#xD;
    CONSTRAINT pk_class_sessions PRIMARY KEY (session_id),&#xD;
    CONSTRAINT ck_class_sessions_no CHECK (session_no &gt; 0),&#xD;
    CONSTRAINT ck_class_sessions_range CHECK (end_at_utc &gt; start_at_utc),&#xD;
    CONSTRAINT fk_class_sessions_class_sessions_rescheduled_from_session_id FOREIGN KEY (rescheduled_from_session_id) REFERENCES class_sessions (session_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_class_sessions_classes_class_id FOREIGN KEY (class_id) REFERENCES classes (class_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_class_sessions_rooms_room_id FOREIGN KEY (room_id) REFERENCES rooms (room_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_class_sessions_user_accounts_coach_id FOREIGN KEY (coach_id) REFERENCES user_accounts (user_id) ON DELETE RESTRICT&#xD;
);&#xD;
CREATE TABLE seat_holds (&#xD;
    hold_id uuid NOT NULL,&#xD;
    class_id integer NOT NULL,&#xD;
    member_id uuid NOT NULL,&#xD;
    invoice_id uuid,&#xD;
    expires_at_utc timestamp with time zone NOT NULL,&#xD;
    status integer NOT NULL,&#xD;
    created_at timestamp with time zone NOT NULL,&#xD;
    CONSTRAINT pk_seat_holds PRIMARY KEY (hold_id),&#xD;
    CONSTRAINT fk_seat_holds_classes_class_id FOREIGN KEY (class_id) REFERENCES classes (class_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_seat_holds_invoices_invoice_id FOREIGN KEY (invoice_id) REFERENCES invoices (invoice_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_seat_holds_user_accounts_member_id FOREIGN KEY (member_id) REFERENCES user_accounts (user_id) ON DELETE RESTRICT&#xD;
);&#xD;
CREATE TABLE enrollments (&#xD;
    enrollment_id uuid NOT NULL,&#xD;
    class_id integer NOT NULL,&#xD;
    member_id uuid NOT NULL,&#xD;
    invoice_item_id uuid,&#xD;
    status integer NOT NULL,&#xD;
    enrolled_at timestamp with time zone NOT NULL,&#xD;
    ended_at timestamp with time zone,&#xD;
    source_enrollment_id uuid,&#xD;
    CONSTRAINT pk_enrollments PRIMARY KEY (enrollment_id),&#xD;
    CONSTRAINT fk_enrollments_classes_class_id FOREIGN KEY (class_id) REFERENCES classes (class_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_enrollments_enrollments_source_enrollment_id FOREIGN KEY (source_enrollment_id) REFERENCES enrollments (enrollment_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_enrollments_invoice_items_invoice_item_id FOREIGN KEY (invoice_item_id) REFERENCES invoice_items (item_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_enrollments_user_accounts_member_id FOREIGN KEY (member_id) REFERENCES user_accounts (user_id) ON DELETE RESTRICT&#xD;
);&#xD;
CREATE TABLE attendances (&#xD;
    attendance_id uuid NOT NULL,&#xD;
    enrollment_id uuid NOT NULL,&#xD;
    session_id uuid NOT NULL,&#xD;
    status integer NOT NULL,&#xD;
    recorded_by_user_id uuid NOT NULL,&#xD;
    recorded_at timestamp with time zone NOT NULL,&#xD;
    last_modified_at timestamp with time zone,&#xD;
    CONSTRAINT pk_attendances PRIMARY KEY (attendance_id),&#xD;
    CONSTRAINT fk_attendances_class_sessions_session_id FOREIGN KEY (session_id) REFERENCES class_sessions (session_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_attendances_enrollments_enrollment_id FOREIGN KEY (enrollment_id) REFERENCES enrollments (enrollment_id) ON DELETE RESTRICT,&#xD;
    CONSTRAINT fk_attendances_user_accounts_recorded_by_user_id FOREIGN KEY (recorded_by_user_id) REFERENCES user_accounts (user_id) ON DELETE RESTRICT&#xD;
);&#xD;
CREATE INDEX ix_classes_coach_id ON classes (coach_id);&#xD;
CREATE UNIQUE INDEX ix_classes_code ON classes (code);&#xD;
CREATE INDEX ix_classes_default_room_id ON classes (default_room_id);&#xD;
CREATE INDEX ix_classes_sport_id_status ON classes (sport_id, status);&#xD;
CREATE INDEX ix_classes_status ON classes (status);&#xD;
CREATE UNIQUE INDEX ix_class_schedule_rules_class_id_day_of_week_start_time_local ON class_schedule_rules (class_id, day_of_week, start_time_local);&#xD;
CREATE UNIQUE INDEX ix_class_sessions_class_id_session_no ON class_sessions (class_id, session_no);&#xD;
CREATE INDEX ix_class_sessions_coach_id_start_at_utc ON class_sessions (coach_id, start_at_utc);&#xD;
CREATE INDEX ix_class_sessions_rescheduled_from_session_id ON class_sessions (rescheduled_from_session_id);&#xD;
CREATE INDEX ix_class_sessions_room_id ON class_sessions (room_id);&#xD;
CREATE INDEX ix_class_sessions_start_at_utc_status ON class_sessions (start_at_utc, status);&#xD;
CREATE INDEX ix_seat_holds_invoice_id ON seat_holds (invoice_id);&#xD;
CREATE INDEX ix_seat_holds_member_id ON seat_holds (member_id);&#xD;
CREATE INDEX ix_seat_holds_status_expires_at_utc ON seat_holds (status, expires_at_utc);&#xD;
CREATE UNIQUE INDEX ux_seat_holds_class_member_active ON seat_holds (class_id, member_id) WHERE status = 0;&#xD;
CREATE INDEX ix_enrollments_member_id_status ON enrollments (member_id, status);&#xD;
CREATE INDEX ix_enrollments_source_enrollment_id ON enrollments (source_enrollment_id);&#xD;
CREATE UNIQUE INDEX ux_enrollments_class_member_confirmed ON enrollments (class_id, member_id) WHERE status = 0;&#xD;
CREATE UNIQUE INDEX ux_enrollments_invoice_item ON enrollments (invoice_item_id) WHERE invoice_item_id IS NOT NULL;&#xD;
CREATE UNIQUE INDEX ix_attendances_enrollment_id_session_id ON attendances (enrollment_id, session_id);&#xD;
CREATE INDEX ix_attendances_recorded_by_user_id ON attendances (recorded_by_user_id);&#xD;
CREATE INDEX ix_attendances_session_id ON attendances (session_id);&#xD;
