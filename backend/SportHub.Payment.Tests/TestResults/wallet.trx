          held_delta integer NOT NULL,&#xD;
          available_after integer NOT NULL,&#xD;
          held_after integer NOT NULL,&#xD;
          reference_type character varying(80) NOT NULL,&#xD;
          reference_id uuid NOT NULL,&#xD;
          actor_user_id uuid,&#xD;
          note character varying(1000),&#xD;
          created_at_utc timestamp with time zone NOT NULL,&#xD;
          CONSTRAINT pk_point_ledger_entries PRIMARY KEY (ledger_entry_id),&#xD;
          CONSTRAINT ck_point_ledger_balance CHECK (available_after &gt;= 0 AND held_after &gt;= 0 AND points &gt; 0),&#xD;
          CONSTRAINT ck_point_ledger_deltas CHECK ((entry_type = 0 AND available_delta = -points AND held_delta = points) OR&#xD;
(entry_type = 1 AND available_delta = points AND held_delta = -points) OR&#xD;
