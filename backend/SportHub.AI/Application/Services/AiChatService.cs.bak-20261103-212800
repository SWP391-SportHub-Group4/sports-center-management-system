using Microsoft.Extensions.Logging;
using Microsoft.EntityFrameworkCore;
using System.Security.Cryptography;
using System.Text;
using Microsoft.AspNetCore.Http;
using SportHub.AI.Application.DTOs.Chat;
using SportHub.AI.Application.Interfaces;
using SportHub.AI.Domain.Constants;
using SportHub.AI.Prompts;
using SportHub.BuildingBlocks.Abstractions.Persistence;
using SportHub.BuildingBlocks.SharedKernel.Errors;
using SportHub.BuildingBlocks.SharedKernel.Time;
using System.Diagnostics;
using System.Text.Json;

namespace SportHub.AI.Application.Services;

public sealed class AiChatService(
    ISportHubDbContext db,
    IAiContextBuilder contextBuilder,
    IAiChatProvider provider,
    IClock clock,
    ISystemPromptReader promptReader,
    Microsoft.Extensions.Logging.ILogger<AiChatService> logger) : IAiChatService
{
    public const int MaxQuestionLength = 2000;

    public const int MaxPreviousInteractionIdLength = 512;

    public async Task<AiChatResponse> AskAsync(
        Guid userId,
        string question,
        string? previousInteractionId = null,
        CancellationToken cancellationToken = default)
    {
        question =
            question?.Trim()
            ?? string.Empty;

        previousInteractionId =
            string.IsNullOrWhiteSpace(
                previousInteractionId)
                ? null
                : previousInteractionId.Trim();

        if (string.IsNullOrWhiteSpace(question))
        {
            throw new BadRequestException(
                "ai_question_required",
                "Question is required.");
        }

        if (question.Length > MaxQuestionLength)
        {
            throw new BadRequestException(
                "ai_question_too_long",
                $"Question must not exceed {MaxQuestionLength} characters.");
        }

        if (
            previousInteractionId?.Length
            > MaxPreviousInteractionIdLength)
        {
            throw new BadRequestException(
                "ai_interaction_id_too_long",
                "PreviousInteractionId is invalid.");
        }

        var context =
            await contextBuilder.BuildAsync(
                userId,
                question,
                cancellationToken);

        using var contextDocument = JsonDocument.Parse(context);
        // Resolve the authenticated role once for both prompt selection and navigation.
        var role = contextDocument.RootElement.TryGetProperty("role", out var roleElement)
            && roleElement.ValueKind == JsonValueKind.String
                ? roleElement.GetString()?.Trim().ToLowerInvariant() switch
                {
                    "member" => "member",
                    "coach" => "coach",
                    _ => "unsupported"
                }
                : "unsupported";

        var isCoach = role == "coach";
        // Keep the published prompt and its version from the incoming branch.
        var publishedPrompt = await promptReader.GetPublishedAsync(
            isCoach ? "Coach" : "Member", cancellationToken);
        var promptVersion = publishedPrompt.Version;
        var systemPrompt = isCoach
            ? publishedPrompt.Content
            : SportHubAssistantSystemPrompt.WithQuestionLanguage(publishedPrompt.Content, question);

        var scopeFingerprint = contextDocument.RootElement.TryGetProperty("accessScope", out var accessScope)
            ? Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(accessScope.GetRawText() + "\n" + promptVersion))) : null;
        if (previousInteractionId is not null)
        {
            var history = await db.Set<AiLog>().AsNoTracking().Where(l => l.UserId == userId && l.QueryType == AiQueryTypes.Chat)
                .OrderByDescending(l => l.CreatedAt).Take(30)
                .Select(l => new { l.InputPayload, l.ResponsePayload }).ToListAsync(cancellationToken);
            var allowed = history.Any(l => MatchesContext(l.InputPayload, l.ResponsePayload, previousInteractionId, scopeFingerprint));
            if (!allowed) previousInteractionId = null;
        }
        // Only Member and Coach have navigation knowledge available in the AI UI.
        var roleSupportsNavigation = role is "member" or "coach";

        // Dedicated role pipelines. No Coach intent handler is shared with Member.
        // Only the trusted backend role selects a pipeline; user text cannot change it.
        string? localAnswer;
        if (role == "coach")
        {
            localAnswer = await CoachChatRuntime.TryAnswerAsync(db, userId, question, clock.UtcNow, cancellationToken);
            if (localAnswer is null)
                localAnswer = await AiCoachAnswerRouter.TryAnswerAsync(
                db, userId, question, clock.UtcNow, cancellationToken);
            if (localAnswer is null && IsExplicitRequestQuestion(question))
                localAnswer = AiCoachRequestAnswers.TryAnswer(question, contextDocument.RootElement);
            // Do not send uncertain Coach UI queries to the old Member/Coach shared fallback.
        }
        else if (role == "member")
        {
            localAnswer = await AiMemberAnswerRouter.TryAnswerAsync(
                db, userId, question, cancellationToken);
            if (localAnswer is null && IsExplicitRequestQuestion(question))
                localAnswer = AiMemberRequestAnswers.TryAnswer(question, contextDocument.RootElement);
            if (localAnswer is null)
                localAnswer = UiNavigationKnowledge.TryAnswer(question, "member");
        }
        else
        {
            throw new SportHub.BuildingBlocks.SharedKernel.Errors.ForbiddenException(
                "ai_chat_role_forbidden", "Only Member and Coach can use the chat assistant.");
        }
        if (localAnswer is null &&
            SportHubTopicGuard.IsClearlyOffTopic(question))
        {
            localAnswer = isCoach
                ? "This question is outside SportHub's scope. I can help with class schedules, students, teaching and training features."
                : "This question is outside SportHub's scope. I can help with SportHub services, classes, booking and training.";
        }

        var stopwatch = Stopwatch.StartNew();

        AiProviderResponse? providerResponse = null;
        Exception? providerFailure = null;

        try
        {
            providerResponse = localAnswer is not null
                ? new AiProviderResponse(Guid.NewGuid().ToString("N"), localAnswer, "SportHub Navigation Knowledge", "local")
                : await provider.AskAsync(systemPrompt, isCoach ? await CoachChatRuntime.BuildContextAsync(db, userId, clock.UtcNow, cancellationToken) : context, question, previousInteractionId, cancellationToken);
        }
        catch (Exception ex)
            when (ex is not OperationCanceledException)
        {
            providerFailure = ex;
            logger.LogError(ex, "AI provider call failed for authenticated role {Role}", role);
        }

        stopwatch.Stop();

        var cleanAnswer = providerResponse is null
            ? string.Empty
            : AiPlainTextSanitizer.Clean(providerResponse.Answer);

        var elapsedMs =
            (int)Math.Min(
                int.MaxValue,
                stopwatch.ElapsedMilliseconds);

        var createdAt =
            clock.UtcNow;

        var logId =
            Guid.NewGuid();

        db.Set<AiLog>().Add(
            new AiLog
            {
                LogId = logId,
                UserId = userId,

                QueryType =
                    AiQueryTypes.Chat,

                InputPayload =
                    JsonSerializer.Serialize(
                        new
                        {
                            question,
                            previousInteractionId,
                            scopeFingerprint,

                            promptVersion =
                                promptVersion
                        }),

                ResponsePayload =
                    JsonSerializer.Serialize(
                        new
                        {
                            interactionId =
                                providerResponse?.InteractionId,

                            answer =
                                providerResponse is null ? null : cleanAnswer,

                            provider =
                                providerResponse?.Provider
                                ?? "Google Gemini",

                            model =
                                providerResponse?.Model,

                            success =
                                providerFailure is null,

                            errorCode =
                                providerFailure
                                is AppException appError
                                    ? appError.ErrorCode
                                    : providerFailure?
                                        .GetType()
                                        .Name
                        }),

                ResponseTimeMs =
                    elapsedMs,

                CreatedAt =
                    createdAt
            });

        await db.SaveChangesAsync(
            cancellationToken);

        if (providerFailure is not null)
        {
            if (providerFailure is AppException appException)
            {
                throw appException;
            }

            throw new AppException(
                StatusCodes.Status502BadGateway,
                "ai_provider_failed",
                "The AI assistant is temporarily unavailable.");
        }

        return new AiChatResponse(
            logId,
            providerResponse!.InteractionId,
            question,
            cleanAnswer,
            providerResponse.Provider,
            providerResponse.Model,
            promptVersion,
            elapsedMs,
            createdAt);
    }
    private static bool MatchesContext(string input, string output, string interactionId, string? fingerprint)
    {
        if (fingerprint is null) return false;
        try {
            using var request = JsonDocument.Parse(input);
            using var response = JsonDocument.Parse(output);
            return request.RootElement.ValueKind == JsonValueKind.Object && response.RootElement.ValueKind == JsonValueKind.Object
                && request.RootElement.TryGetProperty("scopeFingerprint", out var scope) && scope.ValueKind == JsonValueKind.String
                && scope.GetString() == fingerprint && response.RootElement.TryGetProperty("interactionId", out var id)
                && id.ValueKind == JsonValueKind.String && id.GetString() == interactionId;
        } catch (JsonException) { return false; }
    }

    // Explicit Request terms only. "member" and "há»™i viÃªn" are NOT Request intents.
    private static bool IsExplicitRequestQuestion(string question)
    {
        var q = question.ToLowerInvariant();
        return q.Contains("request", StringComparison.Ordinal) ||
               q.Contains("yÃªu cáº§u", StringComparison.Ordinal) ||
               q.Contains("yeu cau", StringComparison.Ordinal) ||
               q.Contains("há»— trá»£", StringComparison.Ordinal) ||
               q.Contains("ho tro", StringComparison.Ordinal) ||
               q.Contains("bÃ¡o váº¯ng", StringComparison.Ordinal) ||
               q.Contains("bao vang", StringComparison.Ordinal);
    }
}
