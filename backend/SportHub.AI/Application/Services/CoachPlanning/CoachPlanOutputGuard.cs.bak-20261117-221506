
using System.Text.RegularExpressions;

namespace SportHub.AI.Application.Services.CoachPlanning;

public static class CoachPlanOutputGuard
{
    private static readonly Regex Prescription = new(
        @"(?<![\w\d+.,-])(?<sets>[+-]?\d+)\s*" +
        @"(?:hiệp|hiep|sets?)\s*" +
        @"(?:[x×*]|by)\s*" +
        @"(?<amount>[+-]?\d+)\s*" +
        @"(?:lần|lan|reps?|seconds?|secs?|giây|giay|minutes?|mins?|phút|phut)\b",
        RegexOptions.IgnoreCase |
        RegexOptions.CultureInvariant
    );

    public static bool Valid(
        string? plan,
        bool sessionScope = true)
    {
        if (string.IsNullOrWhiteSpace(plan))
            return false;

        if (plan.Trim().Length < 75 || plan.Length > 8000)
            return false;

        var rows = plan.Split(
            '\n',
            StringSplitOptions.RemoveEmptyEntries |
            StringSplitOptions.TrimEntries
        );

        if (rows.Length is < 4 or > 10)
            return false;

        foreach (var row in rows)
        {
            if (row.Length > 400)
                return false;

            var separator = row.IndexOf('·');

            if (separator <= 0 || separator >= row.Length - 1)
                return false;

            var heading = row[..separator].Trim();
            var details = row[(separator + 1)..].Trim();

            if (heading.Length == 0 || details.Length == 0)
                return false;

            var matches = Prescription.Matches(details);

            if (matches.Count == 0)
                return false;

            foreach (Match match in matches)
            {
                if (!int.TryParse(
                    match.Groups["sets"].Value,
                    out var sets) || sets <= 0)
                    return false;

                if (!int.TryParse(
                    match.Groups["amount"].Value,
                    out var amount) || amount <= 0)
                    return false;
            }
        }

        return true;
    }
}
