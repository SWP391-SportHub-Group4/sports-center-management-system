# =============================================================================
# Mẫu cấu hình môi trường cho SportHub.
#
# Cách dùng:
#   cp .env.example .env      rồi điền giá trị thật vào .env
#
# .env đã nằm trong .gitignore — KHÔNG commit file đó.
# File .env.example này thì ĐƯỢC commit, nên chỉ chứa giá trị mẫu:
# không đặt mật khẩu thật hay khoá bí mật thật ở đây.
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# docker-compose.yml đọc trực tiếp 4 biến này để dựng container postgres.
#
# LƯU Ý: Postgres chỉ dùng POSTGRES_USER/PASSWORD/DB ở LẦN ĐẦU tạo volume.
# Nếu đã chạy rồi mà đổi user hoặc mật khẩu ở đây thì sẽ không có tác dụng —
# phải xoá volume cũ trước:  docker compose down -v
POSTGRES_USER=sporthub
POSTGRES_PASSWORD=thay-bang-mat-khau-cua-ban
POSTGRES_DB=sporthub

# Cổng mở ra máy host. Để 5435 thay vì 5432 để không đụng Postgres cài sẵn trên máy.
POSTGRES_PORT=5435

# Cổng web trên máy host. Nếu Windows chặn 3000, chọn cổng ngoài vùng dự trữ, ví dụ 3500.
# Khi đổi, cập nhật Cors__AllowedOrigins, Frontend__BaseUrl và VnPay__ReturnUrl bên dưới.
FRONTEND_PORT=3000
# Cổng API trên máy host. Khi đổi, cập nhật NEXT_PUBLIC_API_BASE_URL rồi build lại frontend.
BACKEND_PORT=5000


# -----------------------------------------------------------------------------
# Backend (ASP.NET Core)
# -----------------------------------------------------------------------------
# Dấu __ (hai gạch dưới) là quy ước của ASP.NET Core cho cấu hình lồng nhau:
#   ConnectionStrings__Default  ->  ConnectionStrings:Default
#   JwtOptions__SecretKey       ->  JwtOptions:SecretKey

# Chuỗi kết nối dùng khi chạy backend TRỰC TIẾP trên máy (cd backend/SportHub.API && dotnet run).
# Khi chạy bằng docker compose, biến này bị compose ghi đè thành Host=postgres.
#
# Port phải khớp POSTGRES_PORT, còn Username/Password phải khớp hai biến ở trên —
# lệch nhau là backend không kết nối được dù container postgres vẫn chạy.
ConnectionStrings__Default=Host=localhost;Port=5435;Database=sporthub;Username=sporthub;Password=thay-bang-mat-khau-cua-ban

# Khoá ký JWT — BẮT BUỘC, tối thiểu 32 ký tự
# (JwtOptions.SecretKey có [Required, MinLength(32)], thiếu thì API không khởi động được).
#
# Sinh khoá mới:
#   openssl rand -base64 48
# hoặc trên Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JwtOptions__SecretKey=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Chỉ dùng khi chạy lệnh --bootstrap-initial-admin trên DB mới sau migration.
# Không đặt mật khẩu bootstrap vào file được commit; cung cấp InitialAdmin__Password
# qua secret/biến môi trường riêng khi chạy lệnh.
InitialAdmin__Email=


# -----------------------------------------------------------------------------
# Backend — tuỳ chọn (để trống vẫn chạy được)
# -----------------------------------------------------------------------------
# Bật đăng nhập Google (BR-59/BR-60). Lấy Client ID ở Google Cloud Console.
# Để trống thì POST /api/auth/google trả 503 google_login_not_configured —
# báo rõ là thiếu cấu hình, chứ không lỗi mơ hồ.
Google__ClientId=

# Cloudinary dùng riêng ở backend để lưu/xóa avatar và ảnh trang chủ trong Media.
# Điền API key/secret đã được xoay vào .env cục bộ; không dùng NEXT_PUBLIC_*.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Email provider: Smtp (default) or Brevo (HTTPS; supported on Railway Trial/Hobby).
Email__Provider=Smtp
# Brevo API key (not SMTP key) and a verified sender; required only for Provider=Brevo.
Email__Brevo__ApiKey=
Email__Brevo__FromAddress=
Email__Brevo__FromName=SportHub
# SMTP: Gmail requires a Google App Password, not the account password.
# Missing Host in Development fails email delivery; links/OTPs are never logged.
# A configured SMTP host also requires a matching FromAddress below.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=
Email__Smtp__FromName=SportHub
Email__Smtp__UseSsl=false

# Gốc URL frontend dùng dựng link "Đặt lại mật khẩu" trong email. Đổi thành domain thật khi deploy.
Frontend__BaseUrl=http://localhost:3000
# Website hỗ trợ ghi cuối email (điền khi đã deploy; để trống = chỉ ghi "liên hệ trung tâm").
Frontend__SupportUrl=

# Keep Data Protection keys across API container recreation; production needs a
# durable, access-controlled mount/path and must not use an ephemeral container layer.
# When running dotnet directly on Windows, use a writable Windows path instead,
# e.g. D:/Roy/sports-center-management-system/.sporthub-local/dataprotection-keys.
# docker-compose.yml sets the Linux volume path independently.
DataProtection__KeysPath=/var/lib/sporthub/dataprotection-keys

# VNPay uses the real provider, including its sandbox. Configure merchant credentials,
# add merchant credentials, use the actual frontend origin for ReturnUrl, and register
# a public HTTPS IPN URL at https://<api-domain>/api/payments/vnpay/ipn with VNPay.
VnPay__UseMock=false
VnPay__TmnCode=<TmnCode sandbox của bạn>
VnPay__HashSecret=<HashSecret sandbox của bạn>
VnPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPay__QueryUrl=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VnPay__ReturnUrl=https://<frontend-public>/payments/return

# Thư mục lưu tệp báo cáo đã xuất (BR-46: giữ tối thiểu 6 tháng).
# Để trống thì dùng mặc định <thư mục chạy>/App_Data/reports.
Reports__StorageRoot=


# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
# CẢNH BÁO: mọi biến NEXT_PUBLIC_* đều được nhúng thẳng vào bundle JavaScript
# gửi xuống trình duyệt. KHÔNG đặt bất kỳ giá trị bí mật nào ở đây.
#
# Biến này chỉ có tác dụng khi chạy frontend bằng docker compose.
# Khi chạy `npm run dev` trong thư mục frontend/, Next.js đọc frontend/.env*
# chứ không đọc file .env ở gốc repo — xem frontend/.env.example.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Google Gemini / Flow 6 AI Assistant
Gemini__ApiKey=
Gemini__Model=gemini-3.5-flash-lite

# Daily Coach reminder for missing attendance, Vietnam local hour (0-23).
# The backend must be running; defaults to 22:00 when this setting is omitted.
CoachAttendanceReminders__HourLocal=22
Gemini__BaseUrl=https://generativelanguage.googleapis.com
Gemini__TimeoutSeconds=30

# Explicit local validation setup; required only when missing accounts must be created.
# Set your own strong password (12+ characters), never commit the value.
Seed__Password=
# Public business contact details; leave empty until verified.
PublicContact__Phone=
PublicContact__Email=
PublicContact__Address=
PublicContact__Hours=
