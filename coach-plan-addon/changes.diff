+        var outside = await coach.PostAsJsonAsync(path, new { scope = "personal", memberId = outsider.UserId, goal = "Improve smash", level = "Beginner", language = "en" });
+        Assert.Equal(HttpStatusCode.Forbidden, outside.StatusCode);
