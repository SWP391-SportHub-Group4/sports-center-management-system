# Copy to deploy/aws/.env on the destination only; chmod 600 that file.
# Frontend remains on Vercel. API_DOMAIN is a hostname you control, without scheme.
API_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
FRONTEND_ORIGIN=https://sports-center-management-system-tawny.vercel.app
IMAGE_TAG=local
POSTGRES_DB=railway
POSTGRES_USER=postgres
# private (default), or public after following PUBLIC-DATABASE.md on the server.
POSTGRES_ACCESS=private
POSTGRES_PUBLIC_PORT=15432
# Use a long random alphanumeric destination password (no quotes/semicolons).
POSTGRES_PASSWORD=
# Copy the existing Railway JWT values to retain compatibility.
JWT_SECRET=
JWT_ISSUER=SportHub.Api
JWT_AUDIENCE=SportHub.Client
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=SportHub
GOOGLE_CLIENT_ID=
CLOUDINARY_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
